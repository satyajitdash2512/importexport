# HB Trade API — environment. Copy to .env and adjust. All values have safe
# defaults in src/db/env.ts; nothing here is required to run locally.

# --- database (database-per-tenant) ---------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hb_app
DB_PASSWORD=hb_app_pw
DB_POOL_SIZE=20
# the control (directory + auth) database, and the tenant database naming
CONTROL_DB_NAME=hb_control
TENANT_DB_PREFIX=hb_tenant_
DB_NAME=hb_control        # cosmetic fallback only; business queries route per-tenant

# Admin credentials — used ONLY by the migration runner to create the database
# and application users. The API never connects as this user. Leave blank to
# have the runner fall back to DB_USER (works when the database already exists).
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# --- auth -----------------------------------------------------------------
# CHANGE THESE IN ANY non-local deployment.
JWT_SECRET=dev-only-change-me-hb-trade-access
JWT_REFRESH_SECRET=dev-only-change-me-hb-trade-refresh
ACCESS_TTL=900          # access token lifetime, seconds (15 min)
REFRESH_TTL=604800      # refresh token lifetime, seconds (7 days)
BCRYPT_ROUNDS=10

# --- server ---------------------------------------------------------------
PORT=4000
DEFAULT_PERIOD_KEY=202607   # the period the demo data lives in (YYYYMM)
